[Unit]
Description=Build the Simple-Hyper Grid economic ledger
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=simplehyper
Group=simplehyper
WorkingDirectory=/opt/simple-hyper
Environment=SIMPLE_HYPER_STATE_DIR=/var/lib/simple-hyper
EnvironmentFile=-/opt/simple-hyper/simple-hyper.env
ExecStart=/opt/simple-hyper/.venv/bin/python /opt/simple-hyper/grid_economic_ledger.py --start 2026-07-28T00:00:00+08:00
TimeoutStartSec=10min
Nice=10
UMask=0027
StateDirectory=simple-hyper
StateDirectoryMode=0750
